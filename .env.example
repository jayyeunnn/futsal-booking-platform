# ========================
# JayField - Environment Variables
# ========================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=JayField

# Database (PostgreSQL via Supabase)
# DATABASE_URL = pooled connection (port 6543) — dipakai runtime app
# DIRECT_URL   = direct connection (port 5432) — dipakai prisma migrate
DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-change-in-production

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (Resend) — get key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="JayField <noreply@jayfield.com>"

# File Upload (UploadThing) — get keys at https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=eyJxxxxxxxxxxxxxxxxxxxx
# Legacy (only needed if your account still uses v6 keys):
UPLOADTHING_SECRET=sk_xxxxxxxxxxxxxxxxxxxx
UPLOADTHING_APP_ID=xxxxxxxxxxxx

# Cron jobs — protect endpoints from public hits
# Vercel Cron sends this automatically when set as env var.
CRON_SECRET=generate-a-long-random-string-here

# Web Push (PWA push notifications) — generate via:
#   npx tsx scripts/generate-vapid-keys.ts
# Public key is shipped to the browser, private key stays server-side.
# VAPID_EMAIL must be a `mailto:` URL where push services can reach you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@jayfield.com

# App Settings (overridable via admin dashboard)
DEFAULT_DP_PERCENTAGE=50
PAYMENT_DEADLINE_MINUTES=60
